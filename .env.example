# --- Application ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (docker-compose provides this; adjust for your host)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recon

# --- LLM / Agents (all swappable without code changes) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
LLM_ENABLED=true

# Docker ports (host side) — override if your host already uses these
DB_PORT=5432
APP_PORT=8000
