# ============================================================
# AI Service (FastAPI) — LLM explanation microservice
# ============================================================

# Shared secret with the Django backend (both sides must match).
AI_SERVICE_API_KEY=change-me-generate-a-long-random-string

# OpenRouter / agent configuration (swappable without code changes)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Low temperature: explanations must be faithful, consistent, not creative.
LLM_TEMPERATURE=0.1
# Each validation retry is a full model round-trip (7-20s on the default
# model) — keep this small for latency.
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=45
LLM_ENABLED=true
