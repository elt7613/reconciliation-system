# ============================================================
# Backend (Django) — app config
# ============================================================
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres (local dev default; on Dokploy use the database's internal
# connection string, e.g. postgres://user:pass@<db-app-name>:5432/db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recon

# ============================================================
# AI microservice connection (see ai-service/)
# ============================================================
# Internal URL on the deployment network (Dokploy: http://<ai-app-name>:8000)
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret — MUST match AI_SERVICE_API_KEY in ai-service/.env
AI_SERVICE_API_KEY=change-me-generate-a-long-random-string
# Must exceed the AI service's LLM_TIMEOUT_SECONDS (45s)
AI_SERVICE_TIMEOUT_SECONDS=50
AI_ENABLED=True
